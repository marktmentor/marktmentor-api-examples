# For the app: copy this file to app/.env and fill in your key. Never commit .env.
# The Python scripts do not read a .env file: export the variables in your shell.
# Create a key in the dashboard: Settings -> MarktMentor API.
MARKTMENTOR_API_KEY=mm_live_replace_me
MARKTMENTOR_API_BASE_URL=https://api.marktmentor.nl
# Stop when the research allowance has this many requests left.
MARKTMENTOR_RESERVE=25
# Optional, app only: extra host names the dev server accepts, comma-separated
# (e.g. behind a reverse proxy). Empty: localhost only.
MARKTMENTOR_ALLOWED_HOSTS=
